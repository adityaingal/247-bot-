# ── Core ──────────────────────────────────────────────────────────
TOKEN=your_discord_bot_token
brand_name='Support'
SUPPORT_SERVER_URL="https://discord.gg/UVRWygSpJq"
DISCORD_STATUS="online"
BOT_ACTIVITY="Support | >help"
NEXT_PUBLIC_BRAND_NAME='Support'

# Creator credit shown in embeds (CREATOR_ID optional, makes the name a profile link)
CREATOR_NAME=OGADI
CREATOR_ID=

# Developer credit (Developer Info / Team Info / invite embeds)
DEV_NAME=MD
DEV_ID=1466133502939365437
BOT_INVITE_URL=https://discord.com/oauth2/authorize?client_id=1487525013576749106&permissions=8&integration_type=0&scope=bot+applications.commands

# ── Owner IDs (comma-separated) ───────────────────────────────────
OWNER_IDS=1365657651823771719,1466133502939365437

# ── Lavalink (music) ──────────────────────────────────────────────
LAVALINK_HOST=your-lavalink-host
LAVALINK_PASSWORD=your_password
LAVALINK_SECURE=true
LAVALINK_PORT=

# ── Emoji Sync ────────────────────────────────────────────────────
EMOJI_SYNC=true

# ── API / Dashboard Backend ───────────────────────────────────────
API_ENABLED=true
# Local only — on Render the port comes from $PORT and always wins
API_PORT=8000
DASHBOARD_API_KEY=change_this_to_a_strong_secret
CORS_ORIGINS=

# ── KeepAlive (server-side health checker, ONE task, every 600s) ──
# GET <KEEPALIVE_URL> — our OWN service only, never discord.com.
# 200 = healthy, 4xx/5xx = unhealthy, timeout/error = unreachable.
# It only logs the result — it never restarts the bot.
KEEPALIVE_URL=https://bot-support-aauu.onrender.com/health
KEEPALIVE_INTERVAL=600
KEEPALIVE_ENABLED=true

# ── Webhooks ──────────────────────────────────────────────────────
WEBHOOK_URL=https://discord.com/api/webhooks/...
CMD_WEBHOOK_URL=

# ── Cloudflare Tunnel ─────────────────────────────────────────────
TUNNEL_ENABLED=true
CF_TUNNEL_TOKEN=your_tunnel_token
CF_TUNNEL_URL=https://api.yourdomain.com
