# API URL for the dashboard backend
NEXT_PUBLIC_API_URL=https://xxxx-xxxx-xxxx.ngrok-free.app/api/v1

# API Key for authentication (if used)
NEXT_PUBLIC_DASHBOARD_API_KEY=change_this_to_a_strong_secret

# NextAuth Configuration
NEXTAUTH_URL=https://your-app.vercel.app/
NEXTAUTH_SECRET=generate_a_long_random_string_here

# Discord OAuth configuration
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Admin User IDs (comma separated)
NEXT_PUBLIC_ADMIN_IDS=your_discord_user_id

# Dev-only access (grants/revokes access and opens the Admin Panel)
NEXT_PUBLIC_DEV_IDS=1466133502939365437

# Customizable Brand / Bot name shown across the dashboard
NEXT_PUBLIC_BRAND_NAME="Support"
NEXT_PUBLIC_BRAND_NAME_WORD="SW"
